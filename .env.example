# DeepSeek LLM, optional.
DEEPSEEK_API_KEY=

# FastAPI service.
API_PORT=8000

# MySQL. Local development usually uses 127.0.0.1.
# Docker Compose services will usually use MYSQL_HOST=mysql.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=funds_agent
MYSQL_USER=funds_user
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_CHARSET=utf8mb4

# Optional full SQLAlchemy URL. When set, it takes precedence over MYSQL_*.
DATABASE_URL=
# Example:
# DATABASE_URL=mysql+pymysql://funds_user:change_me@127.0.0.1:3306/funds_agent?charset=utf8mb4

# Redis. Local development usually uses 127.0.0.1.
# Docker Compose services will usually use REDIS_HOST=redis.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=

# Optional full Redis URL. When set, it takes precedence over REDIS_*.
REDIS_URL=
# Example:
# REDIS_URL=redis://127.0.0.1:6379/0

# Report worker.
REPORT_WORKER_POLL_INTERVAL=1.0

# Authentication sessions.
# Session records are stored in Redis for this many seconds.
AUTH_SESSION_TTL_SECONDS=604800
# Set to true when the API is served over HTTPS.
AUTH_COOKIE_SECURE=false
